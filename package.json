{
  "name": "remarkable-blog",
  "version": "1.0.0",
  "description": "Converts handwritten reMarkable pages emailed via Mailgun into published Hugo blog posts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdf-to-img": "^4.5.0",
    "simple-git": "^3.28.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3"
  }
