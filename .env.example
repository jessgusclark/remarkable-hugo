# Claude API key
ANTHROPIC_API_KEY=

# Mailgun HTTP webhook signing key (Mailgun dashboard -> Settings -> API security)
MAILGUN_SIGNING_KEY=

# GitHub personal access token with push access to the blog repo
GITHUB_PAT=

# The email address your reMarkable sends from. Required; other senders are ignored.
ALLOWED_SENDER=

BLOG_REPO_URL=https://github.com/jessgusclark/first-draft.git

# Branch to push to
BLOG_REPO_BRANCH=main

# Server port
PORT=3000

# Local working directory for the blog repo clone (optional)
# REPO_DIR=./blog-repo
